{
  "name": "ikarus-eternal-horizon-poc3",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Ikarus: Eternal Horizon — POC3. Built against .docs3/plans/planning.spec.MD (SDD hub).",
  "scripts": {
    "dev": "vite",
    "dev:all": "node ../scripts/dev.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "nipplejs": "^1.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.8.1",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
